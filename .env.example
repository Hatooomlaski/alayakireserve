# Alayaki Reserve — Optional Environment Variables
# (All variables have built-in fallbacks. You can deploy to Vercel without setting any of these.)

# Public site address (used for canonical links, sitemap, robots and search data).
# Defaults to the live domain; only set this to override it.
NEXT_PUBLIC_SITE_URL=https://www.alayakireserve.store

# Direct WhatsApp line for order routing (international format without '+' or spaces)
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER=2348153861887

# Formatted display string shown in navigation and buttons
NEXT_PUBLIC_DISPLAY_PHONE_NUMBER="+234 815 386 1887"
